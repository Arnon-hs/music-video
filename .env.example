# Keep this file as an example only. Never commit real credentials.
PEXELS_API_KEY=replace_with_your_free_pexels_api_key
POSTIZ_API_KEY=replace_with_your_postiz_api_key
POSTIZ_INTEGRATION_ID=replace_with_your_postiz_integration_id
POSTIZ_API_ROOT=https://api.postiz.com/public/v1
# Set to 1 only for a reviewed self-hosted HTTP endpoint outside loopback.
POSTIZ_ALLOW_INSECURE_HTTP=0
POSTIZ_VIDEO_ROOT=output
# Optional. Leave blank unless the video root is served by a trusted local status server.
POSTIZ_LOCAL_BASE_URL=
STATUS_HOST=127.0.0.1
STATUS_PORT=8765
